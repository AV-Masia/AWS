# Локальный кэш провайдеров — десятки мегабайт, скачивается заново по terraform init.
# .terraform.lock.hcl, наоборот, коммитим: он фиксирует версии провайдеров.
.terraform/

# Стейт содержит пароль RDS открытым текстом. В репозиторий он попасть не должен.
# В проде вместо этого — S3 backend с шифрованием.
*.tfstate
*.tfstate.*
*.tfstate.backup

# my_ip у каждого свой
*.tfvars

# Сохранённый план: внутри — значения переменных, включая пароль RDS
tfplan
*.tfplan
