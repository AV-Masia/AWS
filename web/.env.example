# Скопировать в .env.local и заполнить из `terraform output` в папке infra/.
# .env.local в .gitignore — секретов тут нет, но пусть не попадает в репозиторий.
#
# Пул один на оба задания: страница входа Cognito (задание 1) и Lambda-триггеры
# миграции и honeypot (задание 2) живут в нём же.

# Регион, в котором создан User Pool
VITE_COGNITO_REGION=eu-central-1

# terraform output user_pool_id
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX

# terraform output user_pool_client_id — публичный клиент, без секрета
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# terraform output managed_login_domain. Без слэша на конце
VITE_COGNITO_DOMAIN=https://<prefix>.auth.eu-central-1.amazoncognito.com

# Должен совпадать с Allowed callback URL и Allowed sign-out URL в app client
VITE_REDIRECT_URI=http://localhost:5173
