# Конфиг для публичной сборки на GitHub Pages.
# В отличие от .env.local этот файл коммитится: секретов тут нет —
# client_id и домен видны в адресной строке при любом входе, это часть протокола OIDC.
#
# Внимание: локально .env.local имеет приоритет над этим файлом, поэтому
# `npm run build` на машине соберёт с localhost-адресом. Публичную сборку делает CI,
# где .env.local отсутствует.
#
# Пул один на оба задания, создан Terraform (infra/): в нём и страница входа Cognito
# для задания 1, и триггеры миграции с honeypot для задания 2.

VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_F3JBMc9Ld
VITE_COGNITO_CLIENT_ID=jooc52jcone06i98bhme7anno
VITE_COGNITO_DOMAIN=https://legacy-migration-931110358506.auth.eu-central-1.amazoncognito.com

# Должен совпадать с Allowed callback URL и Allowed sign-out URL в app client —
# посимвольно, включая слэш на конце
VITE_REDIRECT_URI=https://av-masia.github.io/AWS/
