# redis_node_type     = "cache.t4g.micro"

# Реалм Korzinka — обязательные значения, дефолтов нет намеренно.
# google_idp_client_id     = "xxxxxxxx.apps.googleusercontent.com"
# google_idp_client_secret = "xxxxxxxx"

